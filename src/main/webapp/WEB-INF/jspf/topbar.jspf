<header class="topbar">
  <a class="brand" href="${pageContext.request.contextPath}/home"><%@ include file="/WEB-INF/jspf/logo.jspf" %><span>MindMerge</span></a>
  <nav class="topbar-links" aria-label="Sections">
    <a href="#how">How it works</a>
    <a href="#principles">Features</a>
  </nav>
  <div class="topbar-actions">
    <c:choose>
      <c:when test="${not empty sessionScope.user}">
        <a class="pill pill-glow" href="${pageContext.request.contextPath}/dashboard">Dashboard</a>
      </c:when>
      <c:otherwise>
        <a class="pill pill-ghost" href="${pageContext.request.contextPath}/login">Log in</a>
        <a class="pill pill-glow" href="${pageContext.request.contextPath}/register">Get started</a>
      </c:otherwise>
    </c:choose>
  </div>
</header>
